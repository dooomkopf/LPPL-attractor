# LaTeX Rendering style for scientific plots with dark theme
text.usetex : True
font.size : 11
legend.fontsize : 9
font.family : sans-serif
font.sans-serif : TeX Gyre Heros, DejaVu Sans, Arial, sans-serif
xtick.direction : in
ytick.direction : in
xtick.major.size : 5.0
xtick.minor.size : 3.0
ytick.major.size : 5.0
ytick.minor.size : 3.0
axes.linewidth : 0.8
legend.handlelength : 2.0

# Dark theme colors
figure.facecolor : black
axes.facecolor : 1a1a1a
axes.edgecolor : 757575
axes.labelcolor : 0.8
text.color : 0.8
xtick.color : 0.9
ytick.color : 0.9
grid.color : 0.4
legend.facecolor : 181818
legend.edgecolor : 757575
legend.labelcolor : 0.8
legend.framealpha : 0.8
savefig.facecolor : black
savefig.edgecolor : black

# Grid settings
axes.grid : True
grid.alpha : 0.3
grid.linewidth : 0.6

# Font sizes
ytick.labelsize : 10
xtick.labelsize : 10
axes.labelsize : 12
axes.titlesize : 12
figure.titlesize : 13
figure.titleweight : bold

